{
  "name": "memos",
  "private": true,
  "packageManager": "pnpm@11.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release": "vite build --mode release --outDir=../server/frontend/dist --emptyOutDir",
    "lint": "tsc --noEmit --skipLibCheck && biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "test:drawings": "playwright test --config tests/browser/playwright.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@github/relative-time-element": "^5.5.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@pierre/highlights": "0.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@usememos/canvas": "26.11.3",
    "@usememos/editor": "26.11.6",
    "@usememos/ui": "26.11.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.5.0",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "i18next": "^27.2.9",
    "katex": "^0.19.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.80.0",
    "maplibre-gl": "^6.19.0",
    "pele": "1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@biomejs/biome": "^2.6.9",
    "@bufbuild/protobuf": "^2.17.0",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/leaflet": "^1.9.23",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
